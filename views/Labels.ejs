<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Labels</title>
    <style>
        * {
            padding: 0;
            margin: 0;
        }
    </style>
</head>
<body>
    <%- include('_navbar') %>
    <br><br><br><br>
    <center>
        <h1><b>LIST LABELS</b></h1>
        <div><a href="/labels/detail">SHOW DETAIL DURATION</a></div>
        <br>
    </center>
    <center>
        <table border="1" >
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Since</th>
                <th>City</th>
            </tr>
            <% label.forEach((el) => { %>
            <tr>
                <td><%= el.id %></td>
                <td><%= el.name %></td>
                <td><%= el.since %></td>
                <td><%= el.city %></td>
            </tr>
            <% }) %>
        </table>
    </center>
    

</body>
</html>
