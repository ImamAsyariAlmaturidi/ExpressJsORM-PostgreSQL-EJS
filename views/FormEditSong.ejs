<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UPDATE SONG</title>
    <style>
        * {
            padding: 0;
            margin: 0;
        }
    </style>
</head>
<body>
    <%- include('_navbar') %>

    <center style="margin-top: 10px;">
        <h1>Edit Song</h1>
        <% formEditSong.forEach((el) => { %>
        <form method="post" action="/songs/<%= el.id%>/edit">
                <label>Title</label>
                <br><br>
                <input type="text" name="title" required value="<%= el.title %>">
                <br><br>
                <label>Band Name</label>
                <br><br>
                <input type="text" name="bandName" required value="<%= el.bandName %>">
                <br><br>
                <label>Duration</label>
                <br><br>
                <input type="number" name="duration" required value="<%= el.duration %>">
                <br><br>
                <label>Genre</label>
                <br><br>
                <select name="genre" required>
                    <option value="Rock" <%= el.genre === 'Rock' ? 'selected' : '' %>>Rock</option>
                    <option value="Pop" <%= el.genre === 'Pop' ? 'selected' : '' %>>Pop</option>
                    <option value="Dangdut" <%= el.genre === 'Dangdut' ? 'selected' : '' %>>Dangdut</option>
                    <option value="Jazz" <%= el.genre === 'Jazz' ? 'selected' : '' %>>Jazz</option>
                    <option value="Other" <%= el.genre === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
                <br><br>
                <label>Lyric</label>
                <br><br>
                <textarea name="lyric" rows="10" cols="50" placeholder="<%= el.lyric %>"></textarea>
                <br><br>
                <label>ImageUrl</label>
                <br><br>
                <input type="text" name="imageUrl" required value="<%= el.imageUrl %>">
                <br><br>
                <label>Label</label>
                <br><br>
                <select name="LabelId" required>  
                    <% formSong.forEach((el) => { %>
                        <option value="<%= el.id %>"><%= el.LabelName %></option>
                    <% }) %>
                </select>
                <br><br>
                <label>Created Date</label>
                <br><br>
                <input type="date" name="createdDate" required value="<%= el.createdDate %>">
                <br><br>
                <button type="submit">Update</button>
            </form>
            <% }) %>
    </center>
    
    
</body>
</html>